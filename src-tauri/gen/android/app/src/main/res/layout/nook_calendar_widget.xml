<?xml version="1.0" encoding="utf-8"?>
<!--
  Виджет-календарь: месяц целиком.

  Отдельная разметка, а не общая с остальными виджетами: у тех список строк, а
  здесь сетка. И это правильный порядок вещей — виджет остаётся календарём,
  даже когда дел нет вовсе, а записи проявляются на нём точками.

  Шапка — название месяца крупно, логотип мелко справа: на календаре важнее
  какой месяц, чем чьё это приложение.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/nook_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/nook_widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/nook_widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/nook_cal_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/nook_widget_fg" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="11dp"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:alpha="0.7"
                android:contentDescription="@string/app_name"
                android:src="@drawable/nook_wordmark" />
        </LinearLayout>

        <!--
          Шапка недели статичная: семь подписей, которые никогда не меняются.
          Гонять их через адаптер значило бы вычислять на каждой отрисовке то,
          что известно заранее.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView style="@style/NookWeekday" android:text="@string/nook_wd_mon" />
            <TextView style="@style/NookWeekday" android:text="@string/nook_wd_tue" />
            <TextView style="@style/NookWeekday" android:text="@string/nook_wd_wed" />
            <TextView style="@style/NookWeekday" android:text="@string/nook_wd_thu" />
            <TextView style="@style/NookWeekday" android:text="@string/nook_wd_fri" />
            <TextView style="@style/NookWeekday" android:text="@string/nook_wd_sat" />
            <TextView style="@style/NookWeekday" android:text="@string/nook_wd_sun" />
        </LinearLayout>

        <GridView
            android:id="@+id/nook_cal_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:numColumns="7"
            android:verticalSpacing="0dp"
            android:horizontalSpacing="0dp"
            android:stretchMode="columnWidth"
            android:listSelector="@android:color/transparent"
            android:gravity="center" />

        <!-- Никогда не показывается: у календаря пустого состояния нет, месяц
             есть всегда. Нужен только чтобы общий код обновления не спотыкался. -->
        <TextView
            android:id="@+id/nook_widget_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
